# ─────────────────────────────────────────────────────────────
# Créateur DZ — Client Environment Variables
# Note: Only variables prefixed with VITE_ are exposed to the browser.
# DO NOT place backend secrets (like service_role_key or chargily_secret_key) here.
# ─────────────────────────────────────────────────────────────

# Supabase Public API (Required for Auth & Data Queries)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_anon_key

# ─────────────────────────────────────────────────────────────
# Backend Secrets (Set via Supabase CLI / Edge Functions Secrets ONLY):
#   supabase secrets set CHARGILY_SECRET_KEY=test_sk_xxx
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=ey...
# ─────────────────────────────────────────────────────────────
